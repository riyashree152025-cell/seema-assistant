<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_reactor"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="SEEMA"
        android:src="@drawable/ic_widget_reactor" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="SEEMA"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="OFFLINE"
        android:textColor="#80DEEA"
        android:textSize="9sp" />

    <Button
        android:id="@+id/widget_talk"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_button"
        android:fontFamily="monospace"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:text="TALK"
        android:textColor="#00E5FF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_routine_1"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_button"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:textColor="#80DEEA"
            android:textSize="9sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/widget_routine_2"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:textColor="#80DEEA"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
